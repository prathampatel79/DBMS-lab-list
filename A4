 CREATE TABLE SALES
  (
       SNO NUMBER(3),
       SNAME VARCHAR2(15) NOT NULL,
       MNO NUMBER(3),
       JOIN_DATE DATE NOT NULL,
       DATE_BIRTH DATE NOT NULL,
       SALARY NUMBER(8,2) NOT NULL,
       SALES_AMOUNT NUMBER(8,2)NOT NULL,
       COMMISSION NUMBER(8,2) DEFAULT 0,
       CONSTRAINT PK_SALES PRIMARY KEY(SNO),
       CONSTRAINT FK_MANAGER FOREIGN KEY(MNO)
       REFERENCES SALES(SNO),
       CONSTRAINT CHK_AGE
       CHECK(MONTHS_BETWEEN(JOIN_DATE,DATE_BIRTH)/12>=18)
  );

