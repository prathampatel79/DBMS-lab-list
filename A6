create table supplier(
supplier_no number(10) PRIMARY KEY,
SNAME VARCHAR2(20) NOT NULL,
SADDRESS VARCHAR2(30) NOT NULL,
SCITY VARCHAR2(30) NOT NULL
);

CREATE TABLE COMPUTER(
ITEM_NO NUMBER(10),
SUPPLIER_NO NUMBER(10),
ITEM_NAME VARCHAR2(20) NOT NULL,
IQTY NUMBER(5) NOT NULL,
CONSTRAINT PK_ITEM_NO PRIMARY KEY(ITEM_NO),
CONSTRAINT FK_SNO FOREIGN KEY(SUPPLIER_NO) REFERENCES SUPPLIER(SUPPLIER_NO)
);


