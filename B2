SET SERVEROUTPUT ON	

DECLARE
	V_PNO SD.PNO%TYPE:=&PNO;
	V_QTY NUMBER:=&QUANTITY;
	V_QTY_AVL SD.QTY_AVL%TYPE;
	LOW_STOCK EXCEPTION;
BEGIN
	SELECT QTY_AVL INTO V_QTY_AVL FROM SD
	WHERE PNO=V_PNO;
	IF V_QTY>V_QTY_AVL THEN 
		RAISE LOW_STOCK;
	ELSE
		UPDATE SD
		SET QTY_AVL=QTY_AVL-V_QTY
		WHERE PNO=V_PNO;
		COMMIT;
		DBMS_OUTPUT.PUT_LINE('TRANSACTION SUCCESSFULL');
		DBMS_OUTPUT.PUT_LINE('REMAINING STOCK='||(V_QTY_AVL-V_QTY));
	END IF;
EXCEPTION
	WHEN LOW_STOCK THEN
		DBMS_OUTPUT.PUT_LINE('NO SUFFICIENT STOCK');
	WHEN NO_DATA_FOUND THEN
		DBMS_OUTPUT.PUT_LINE('NO SUCH PRODUCT EXISTS');
END;
/
