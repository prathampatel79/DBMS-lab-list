 CREATE TABLE EMPLOY
   (
    EMPNO NUMBER(3) PRIMARY KEY,
    NAME VARCHAR2(15) NOT NULL,
    DESIGNATION VARCHAR(20) NOT NULL,
    DEPARTMENT VARCHAR(20) NOT NULL,
    GENDER CHAR(1) NOT NULL,
    SALARY NUMBER(10,2) NOT NULL,
    CHECK(GENDER IN ('M','F')),
    CHECK(DEPARTMENT IN ('SALES','ACCOUNTS','IT')),
    CHECK(
          (DEPARTMENT='SALES' AND DESIGNATION IN('CLERK','MANAGER','SUPERVISOR'))
           OR
          (DEPARTMENT='ACCOUNTS' AND DESIGNATION IN('ACCOUNTANT','MANAGER','SUPERVISOR'))
           OR
          (DEPARTMENT='IT' AND DESIGNATION IN('ANALYST','MANAGER','SUPERVISOR'))   
    )
)
   );
