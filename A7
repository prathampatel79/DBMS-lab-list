 CREATE TABLE PRODUCT_DETAIL
    (
       P_NO VARCHAR2(5) PRIMARY KEY,
       PRODUCTNAME VARCHAR2(10) NOT NULL,
       QTYAVAILABLE NUMBER(8,2) NOT NULL,
       PRICE NUMBER(8,2) NOT NULL,
       PROFIT NUMBER(5,2) NOT NULL
    );

Table created.

 CREATE TABLE PURCHASED_DETAIL
    (
       CUSTNO VARCHAR2(5) NOT NULL,
       P_NO VARCHAR2(5) NOT NULL,
       QTYSOLD NUMBER(5) NOT NULL,
       CONSTRAINT PK_PURCHASED PRIMARY KEY(CUSTNO,P_NO),
       CONSTRAINT FK_PURCHASED_PRODUCT FOREIGN KEY(P_NO)
       REFERENCES PRODUCT_DETAIL(P_NO)
    );

A:=
 

  SELECT SUM(PD.PRICE*P.QTY_SOLD)
  AS TOTAL_AMOUNT
  FROM PRODUCT_DETAIL PD,
  PURCHASED_DETAIL P
  WHERE PD.P_NO=P.P_NO
  AND P.CUST_NO='C2';

B:=
  SELECT PRODUCTNAME
  FROM PRODUCT_DETAIL
  WHERE QTY_AVAILABLE<30
  UNION
  SELECT PD.PRODUCTNAME
  FROM PRODUCT_DETAIL PD,
  PURCHASED_DETAIL P
  WHERE PD.P_NO=P.P_NO
  GROUP BY PD.P_NO,PD.PRODUCTNAME
  HAVING SUM (P.QTY_SOLD)<5;


C:=

   SELECT PD.PRODUCTNAME,P.QTYSOLD
   FROM PRODUCT_DETAIL PD,
   PURCHASED_DETAIL P
   WHERE PD.P_NO=P.P_NO
   AND P.CUSTNO='C1';



D:=
  

SELECT SUM(P.QTY_SOLD*PD.PRICE*PD.PROFIT/100)
AS TOTAL_PROFIT
FROM PRODUCT_DETAIL PD,
PURCHASED_DETAIL P,
WHERE PD.P_NO=P.P_NO
AND P.CUSTNO='C1';


E:=

 SELECT SUM (P.QTY_SOLD)
 AS TOTAL_PEN_DRIVES_SOLD
 FROM PRODUCT_DETAIL PD,
 PURCHASED_DETAIL P
 WHERE PD.P_NO=P.P_NO
 AND PD.PRODUCTNAME='PEN DRIVES';

 
