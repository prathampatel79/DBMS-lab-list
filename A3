 CREATE TABLE BOOK
    ( ACCESSION_NO NUMBER(10) ,
     TITLE VARCHAR2(20)  NOT NULL,
     AUTHOR  VARCHAR2(20) NOT NULL,
    PUBLISHER VARCHAR2(20) NOT NULL,
   YEAR NUMBER(4) NOT NULL,
   PRICE NUMBER(10,2) NOT NULL,
   CONSTRAINT PK_BOOK PRIMARY KEY(ACCESSION_NO)
   );

