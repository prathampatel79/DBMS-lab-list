  

   CREATE TABLE SALES_DETAILS
   (
        SNO VARCHAR2(5),
        MONTH VARCHAR2(15),
        TARGET NUMBER(8),
        QTY_SOLD NUMBER(10),
        CHECK (TARGET>0),
        CHECK (QTY_SOLD>0),
        CONSTRAINT PK_SALES_DETAILS PRIMARY KEY(SNO,MONTH)   
   );

